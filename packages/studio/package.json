{
  "name": "@b-dash/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 4 Studio v1 — visual builder foundation. Block-manifest emitter for Puck (or any visual editor) built from SectionSchema instances.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@b-dash/schemas": "workspace:*",
    "@b-dash/wirer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
