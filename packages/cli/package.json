{
  "name": "@b-dash/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "b-dash CLI — validate, generate, and manage B-Dash app recipes.",
  "bin": {
    "b-dash": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@b-dash/schemas": "workspace:*",
    "@b-dash/wirer": "workspace:*",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
