{
  "name": "b-dash-app-generator",
  "version": "0.1.0",
  "private": true,
  "description": "B-Dash app generator — meta-system for building production-ready, customer-owned web applications.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,md}\"",
    "build:business-doc": "node build-business-doc.js"
  },
  "dependencies": {
    "html-to-docx": "^1.8.0",
    "marked": "^18.0.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  }
}
